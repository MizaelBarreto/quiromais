# Copie para .env.local e preencha. Na Vercel: Project → Settings → Environment Variables.

# Supabase (servidor apenas — nunca use NEXT_PUBLIC_ nessas)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# E-mail de aviso de novo cadastro (SMTP). Com Gmail: conta com verificação em 2 etapas →
# https://myaccount.google.com/apppasswords → gere uma "senha de app" e cole em SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=quiromaisoficial@gmail.com
SMTP_PASS=
LEADS_NOTIFY_TO=quiromaisoficial@gmail.com,mizaelmbarreto@gmail.com

# Google Analytics 4 (ID de medição "G-XXXXXXXXXX"). Vazio = sem Analytics.
NEXT_PUBLIC_GA_ID=
